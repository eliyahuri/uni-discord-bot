{
    "include": [
        "src/**/*.ts"
    ],
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "skipLibCheck": true,
        "strict": true,
        "esModuleInterop": true,
        "module": "CommonJS",
        "forceConsistentCasingInFileNames": true,
        "target": "ESNext",
        "checkJs": true,
        "types": [
            "node"
        ],
        "lib": [
            "ESNext",
            "DOM"
        ],
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "pretty": true,
        "noEmitOnError": true,
        "resolveJsonModule": true
    }
}